# Fresh Eyes server configuration. Copy to .env for local development.

# Port the Express server listens on.
PORT=8787

# Optional server-side Claude API key. Used only as a fallback when a request
# does NOT supply its own key. Leave blank to require every request to bring
# its own key (recommended for privacy — confidential assets go only to the
# uploader's own Anthropic account). Never commit a real key.
ANTHROPIC_API_KEY=

# The Claude model used for vision analysis. A capable vision model is required.
CLAUDE_MODEL=claude-sonnet-5

# Set to 1 to run in DEMO mode: no Claude API is called, a deterministic canned
# result is returned so the full UI can be exercised without a key or spend.
# Leave unset/0 for real analysis.
DEMO_MODE=0

# Hard limits (see PRD Section 6.1 / Open Decision 5).
MAX_FILE_SIZE_MB=25
MAX_BATCH_FILES=50
