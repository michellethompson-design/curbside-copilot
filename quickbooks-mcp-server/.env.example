# ── QuickBooks read-only MCP server ─────────────────────────────────────────
# Copy to .env (or export in your shell / MCP client config) and fill in.
# NEVER commit real values. .env is gitignored.

# From your Intuit developer app → "Keys & credentials"
# https://developer.intuit.com/app/developer/dashboard
QB_CLIENT_ID=
QB_CLIENT_SECRET=

# QuickBooks company ID ("realm ID"). Shown during OAuth authorization,
# or in QuickBooks under Settings → Additional Info.
QB_REALM_ID=

# sandbox | production   (default: sandbox)
QB_ENVIRONMENT=sandbox

# ── Token storage (choose ONE approach) ─────────────────────────────────────
# Option A (recommended): encrypted token store file. Run `npm run auth` once
# to authorize and populate it. Generate the key with:  openssl rand -hex 32
QB_TOKEN_STORE_PATH=
QB_TOKEN_ENCRYPTION_KEY=

# Option B: seed refresh token directly from the environment. Note Intuit
# ROTATES refresh tokens on every refresh; without the encrypted store the
# rotated token lives only in process memory, so this value can go stale
# after the process exits.
QB_REFRESH_TOKEN=

# ── Optional tuning ─────────────────────────────────────────────────────────
# QuickBooks API minor version (default: 75, the current Intuit baseline)
#QB_MINOR_VERSION=75
# Safety cap on pages fetched per entity query (1000 rows/page; default: 10)
#QB_MAX_QUERY_PAGES=10
# Port for the one-time OAuth redirect helper (default: 8722)
#QB_OAUTH_REDIRECT_PORT=8722
