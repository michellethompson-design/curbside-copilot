{
  "name": "quickbooks-mcp-server",
  "version": "0.1.0",
  "description": "Read-only MCP server for the QuickBooks Online Accounting API (Intuit OAuth 2.0)",
  "type": "module",
  "bin": {
    "quickbooks-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "auth": "tsx scripts/get-tokens.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.sandbox.test.ts'",
    "test:sandbox": "vitest run test/sandbox.integration.sandbox.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
